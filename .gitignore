# Raw source material (CV, original photos, links) - not part of the published site.
# Everything needed for the live site is copied/cleaned into assets/ and data/.
/Resources/

# Misc local notes not meant for the public repo
/Claude Code Prompts/

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Claude Code harness-local state (not project content)
.claude/

# LaTeX build artifacts (assets/CV-Latex-Template/ holds the CV source;
# only the .tex files and the icon/photo assets are tracked - the icon
# PDFs there are real assets, not build output, so only the compiled
# CV output is excluded by name, not by *.pdf)
assets/CV-Latex-Template/*.aux
assets/CV-Latex-Template/*.log
assets/CV-Latex-Template/*.out
assets/CV-Latex-Template/*.synctex.gz
assets/CV-Latex-Template/CV_FARUK.pdf
